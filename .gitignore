# ==========================================
# 1. 보안 및 자격 증명 (최우선 차단)
# ==========================================
.env
.env.*
*.pem
*.key
*.ppk
id_rsa
id_rsa.pub
id_ed25519
*.p12
*.cer
.aws/

# ==========================================
# 2. Terraform 관련 파일
# ==========================================
# 로컬 캐시 및 플러그인
**/.terraform/
.terraform/

# 상태 파일
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# 변수 파일 (예제 템플릿 파일은 허용)
*.tfvars
*.tfvars.json
**/*.tfvars
**/*.tfvars.json
!*.tfvars.example

# 로컬 오버라이드 설정
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# 크래시 로그 및 CLI 설정
crash.log
crash.*.log
.terraformrc
terraform.rc

# ==========================================
# 3. Python 가상환경 및 캐시
# ==========================================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 4. 빌드 결과물 및 배포 압축본
# ==========================================
build/
dist/
*.egg-info/
*.zip
*.tar.gz

# ==========================================
# 5. OS 및 에디터 임시 파일
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~